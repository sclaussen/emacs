#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# Operating System Detection
#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
if [[ "$OSTYPE" == "darwin"* ]]; then
    export IS_MACOS=true
    export IS_DEBIAN=false
else
    export IS_MACOS=false
    export IS_DEBIAN=true
fi

#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# Workspace Configuration
#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# Returns the effective workspace root: WSROOT in containers, config value on host
wsroot() { echo "${WSROOT:-$(dev config g workspace)}"; }

#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# Locale Configuration (important for Debian containers)
#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
export TZ=America/Los_Angeles
if [[ $IS_DEBIAN == true ]]; then
    [ -z "$TERM" ] && export TERM=xterm
fi

#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# Command History Configuration (useful for containers)
#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
if [[ $IS_DEBIAN == true ]] && [[ -d /commandhistory ]]; then
    export PROMPT_COMMAND='history -a'
    export HISTFILE=/commandhistory/.bash_history
fi

#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# Finding files
#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
f()      { find . -type f -name "*$@*" -print | grep -v node_ | grep -v '\.git/' | grep -v '\.md/' | grep -v .archive | grep -v '/.#' }                                 # Find all regular files matching a pattern, excluding node_, .git, and temporary files
fjs()    { find . -type f -name '*.js' | grep -v node_modules | grep -v .venv | grep -v .git | grep -v .md | grep -v .archive | grep -v '/.#' }                       # Find all JavaScript (*.js) files, excluding node_modules, .git, and temporary files
fts()    { find . -type f -name '*.ts' | grep -v node_modules | grep -v .venv | grep -v .git | grep -v .md | grep -v .archive | grep -v '/.#' }                       # Find all TypeScript (*.ts) files, excluding node_modules, .git, and temporary files
fmd()    { find . -type f -name '*.md' | grep -v node_ | grep -v .git | grep -v .md | grep -v .archive | grep -v '/.#' }                                              # Find all Markdown (*.md) files, excluding node_, .git, and temporary files
fyaml()  { find . -type f -name '*.yaml' | grep -v node_modules | grep -v .venv | grep -v .git | grep -v .md | grep -v .archive | grep -v '/.#' }                     # Find all YAML (*.yaml) files, excluding node_modules, .git, and temporary files
fswift() { find . -type f -name '*.swift' | grep -v node_modules | grep -v .venv | grep -v .git | grep -v .md | grep -v .archive | grep -v '/.#' }                    # Find all Swift (*.swift) files, excluding node_modules, .git, and temporary files
fstart() { find . -type f -name "$@"'*' -print | grep -v node_modules | grep -v .venv | grep -v .git | grep -v .md | grep -v .archive | grep -v '/.#' }               # Find files starting with a specific string, excluding node_, .git, and temporary files
feend()  { find . -type f -name '*'"$@" -print | grep -v node_modules | grep -v .venv | grep -v .git | grep -v .md | grep -v .archive | grep -v '/.#' }               # Find files ending with a specific string, excluding node_, .git, and temporary files
todo()   { find . -type f -name "*.js" ! -path "./node_modules/*" -exec grep -H "TODO:" {} \; | sed "s/: */: /g" }                                                    # Find TODO comments in JavaScript files

#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# Grep Files for Matching Text
#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
g()      { find . -print | grep -v node_ | grep -v .git | grep -v .md | grep -v .archive | xargs grep "$@" 2>/dev/null }                                               # Find all regular files matching a pattern, excluding node_, .git, and temporary files
gjs()    { find . -type f -name '*.js' | grep -v node_modules | grep -v .venv | grep -v .git | grep -v .md | grep -v .archive | xargs grep "$@" 2>/dev/null }          # Find all JavaScript (*.js) files, excluding node_modules, .git, and temporary files
gts()    { find . -type f -name '*.ts' | grep -v node_modules | grep -v .venv | grep -v .git | grep -v .md | grep -v .archive | xargs grep "$@" 2>/dev/null }          # Find all TypeScript (*.ts) files, excluding node_modules, .git, and temporary files
gmd()    { find . -type f -name '*.md' | grep -v node_ | grep -v .git | grep -v .md | grep -v .archive | xargs grep "$@" 2>/dev/null }                                 # Find all Markdown (*.md) files, excluding node_, .git, and temporary files
gyaml()  { find . -type f -name '*.yaml' | grep -v node_modules | grep -v .venv | grep -v .git | grep -v .md | grep -v .archive | xargs grep "$@" 2>/dev/null }        # Find all YAML (*.yaml) files, excluding node_modules, .git, and temporary files
gswift() { find . -type f -name '*.swift' | grep -v node_modules | grep -v .venv | grep -v .git | grep -v .md | grep -v .archive | xargs grep "$@" 2>/dev/null }       # Find all Swift (*.swift) files, excluding node_modules, .git, and temporary files

#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# Z Shell Options
#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
export ENABLE_CORRECTION="true"                                                      # Enable spell correction for mistyped commands and paths. When set to "true", Zsh will attempt to correct minor spelling errors.
export COMPLETION_WAITING_DOTS="true"                                                # Display animated dots while the shell is processing command completions. This provides visual feedback during potentially long completion operations.
export HISTSIZE=5000                                                                 # Set the maximum number of events stored in the internal history.
export SAVEHIST=5000                                                                 # Specify the number of history entries to save to the history file.
export HISTDUP=erase                                                                 # Configure how duplicate history entries are handled. Setting to "erase" removes previous duplicates when a new duplicate is added.
# Set default editor based on OS
if [[ $IS_DEBIAN == true ]]; then
    export EDITOR='vi'                                                               # Set default editor for Linux/Debian
    export VISUAL='vi'                                                               # Set default visual editor for Linux/Debian
fi
export AUTO_CD=true                                                                  # Enable automatic changing of directories. Allows you to switch directories by simply typing the directory name without using `cd`.
setopt appendhistory                                                                 # Enable appending to the history file, rather than overwriting it.
setopt incappendhistory                                                              # Enable incremental history appending. Writes to the history file as commands are entered, rather than waiting until the session ends.
setopt hist_ignore_all_dups                                                          # Prevent duplicate entries in the command history.
setopt hist_save_no_dups                                                             # Save only unique entries to the history file.
setopt hist_ignore_dups                                                              # Ignore duplicate commands when adding to history.
setopt hist_find_no_dups                                                             # Prevent duplicate entries when searching through history.
autoload -Uz compinit && compinit                                                    # Initialize the Zsh completion system. Loads all the necessary functions for command-line completion.
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'                               # Configure the completion system to perform case-insensitive matching. Allows you to use uppercase or lowercase letters interchangeably during completions.

#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# Uses emacs bindings for the CLI, but vi-like Ctrl-p/Ctr-n, emacs Ctrl-s/Ctrl-r
#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
bindkey -e                                                                           # Set the key bindings to Emacs mode.
autoload -U up-line-or-beginning-search
autoload -U down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^P' up-line-or-beginning-search
bindkey '^N' down-line-or-beginning-search

#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# Node.js Configuration
#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# export NODE_TLS_REJECT_UNAUTHORIZED=0

#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# Custom Functions and Variables
#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
export ZSH_SPECTRUM_TEXT=${ZSH_SPECTRUM_TEXT:-Arma virumque cano Troiae ab oris}     # Define the default text to display when showcasing all 256 terminal colors.
function colors() {                                                                  # Function to display all 256 terminal colors along with their corresponding color codes.
    for code in {000..255}; do
        print -P -- "$code: %F{$code}$ZSH_SPECTRUM_TEXT%{$reset_color%}"
    done
}

#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# Python configuration
#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
export PATH=".:$PATH"                                                                # Add current directory to PATH
export PATH="$HOME/.pyenv/shims:$PATH"                                               # Allows pyenv python to take priority over system python
export PATH="$HOME/.local/bin:$PATH"                                                 # For pipx and local binaries
# Debian-specific local bin paths
if [[ $IS_DEBIAN == true ]]; then
    [[ -f "$HOME/.local/bin/env" ]] && . "$HOME/.local/bin/env"
    [[ -f "$HOME/.local/bin/env.sh" ]] && source "$HOME/.local/bin/env.sh"
fi
alias p='python3'
alias p3='python3'

#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# Claude Code
#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
if [[ $IS_DEBIAN == true ]]; then
    alias cc='claude --settings ${WSROOT}/.claude/settings.json --mcp-config ${WSROOT}/.mcp.json --dangerously-skip-permissions'
    alias ccc='claude --settings ${WSROOT}/.claude/settings.json --mcp-config ${WSROOT}/.mcp.json --dangerously-skip-permissions --continue'
    alias ccr='claude --settings ${WSROOT}/.claude/settings.json --mcp-config ${WSROOT}/.mcp.json --dangerously-skip-permissions --resume'
fi
if [[ $IS_MACOS == true ]]; then
    alias cc='NODE_TLS_REJECT_UNAUTHORIZED=0 claude --settings ~/src/.claude/settings.json --mcp-config ~/src/.mcp.json --dangerously-skip-permissions'
    alias ccc='NODE_TLS_REJECT_UNAUTHORIZED=0 claude --settings ~/src/.claude/settings.json --mcp-config ~/src/.mcp.json --dangerously-skip-permissions --continue'
    alias ccr='NODE_TLS_REJECT_UNAUTHORIZED=0 claude --settings ~/src/.claude/settings.json --mcp-config ~/src/.mcp.json --dangerously-skip-permissions --resume'
fi

#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# Node Version Manager (NVM)
#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"                                   # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"                 # This loads nvm bash_completion

# Add npm global binaries to PATH (after NVM loads)
if command -v npm >/dev/null 2>&1; then
    export PATH="$(npm config get prefix 2>/dev/null)/bin:$PATH"
fi

#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# General
#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
alias z='. ~/.zshrc'                                                               # Reload zsh configuration in current shell
alias genpdf='markdown-pdf'                                                        # Convert Markdown to PDF
alias path='echo -e ${PATH//:/\\n}'                                                # Display each PATH entry on separate lines
# Tag generation aliases based on OS
alias lc="find . -type f -name '*.js' -print | grep -v node_ | grep -v .git | grep -v '/.#' | xargs wc -l"     # Line count for JS files
tre() { tree -aC -I '.git|node_modules|.DS_Store|__pycache__' --dirsfirst "$@"; }              # Display directory tree excluding certain directories
tred() { tree -daC -I '.git|node_modules|.DS_Store|__pycache__' --dirsfirst "$@"; }            # Display directory tree (dirs only) excluding certain directories
tre2() { tree -daCL 2 -I '.git|node_modules|.DS_Store|__pycache__' --dirsfirst "$@"; }         # Display directory tree (dirs only, 2 levels deep)
tre3() { tree -daCL 3 -I '.git|node_modules|.DS_Store|__pycache__' --dirsfirst "$@"; }         # Display directory tree (dirs only, 3 levels deep)
trep() {                                                                            # Tree view of profiles/capabilities at repo root
    local root
    root=$(git rev-parse --show-toplevel 2>/dev/null)
    if [[ -z "$root" ]]; then
        echo "Error: Not in a git repository"
        return 1
    fi
    local _trep_sub() {
        local dir="$1" label="$2" prefix="$3" is_last="$4"
        local connector=$([[ "$is_last" == "1" ]] && echo "└── " || echo "├── ")
        local child_prefix=$([[ "$is_last" == "1" ]] && echo "    " || echo "│   ")
        echo "${prefix}${connector}${label}"
        local entries=("$dir"/*(N:t))
        local j=0
        for entry in "${entries[@]}"; do
            j=$((j + 1))
            local ec=$([[ $j -eq ${#entries[@]} ]] && echo "└── " || echo "├── ")
            echo "${prefix}${child_prefix}${ec}${entry}"
        done
    }
    local _trep_section() {
        local dir="$1" label="$2" prefix="$3" is_last="$4"
        local connector=$([[ "$is_last" == "1" ]] && echo "└── " || echo "├── ")
        local child_prefix=$([[ "$is_last" == "1" ]] && echo "    " || echo "│   ")
        echo "${prefix}${connector}${label}"
        local subs=()
        [[ -d "$dir/profiles" ]] && subs+=(profiles)
        [[ -d "$dir/capabilities" ]] && subs+=(capabilities)
        local i=0
        for sub in "${subs[@]}"; do
            i=$((i + 1))
            local sub_last=$([[ $i -eq ${#subs[@]} ]] && echo "1" || echo "0")
            _trep_sub "$dir/$sub" "$sub" "${prefix}${child_prefix}" "$sub_last"
        done
    }
    echo "."
    local sections=()
    [[ -d "$root/profiles" ]] && sections+=(profiles)
    [[ -d "$root/capabilities" ]] && sections+=(capabilities)
    for nsdir in "$root"/ns/*(N/); do
        sections+=("ns/${nsdir:t}")
    done
    if [[ ${#sections} -eq 0 ]]; then
        echo "  (no profiles/, capabilities/, or ns/*/ directories found)"
        return 1
    fi
    local i=0
    for section in "${sections[@]}"; do
        i=$((i + 1))
        local is_last=$([[ $i -eq ${#sections[@]} ]] && echo "1" || echo "0")
        if [[ "$section" == "profiles" || "$section" == "capabilities" ]]; then
            _trep_sub "$root/$section" "$section" "" "$is_last"
        else
            _trep_section "$root/$section" "$section" "" "$is_last"
        fi
    done
}
zipf() { zip -r "$1".zip "$1"; }                                                   # Create a ZIP archive of a folder

#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# Operating System CLIs
#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
alias grep='grep --color=auto'                                                     # Enable colored output for grep
du() { "du -hs "$1:-." 2>/dev/null | sort -h" }                                    # Human-readable disk usage sorted
alias cls='tput clear'                                                             # Clear terminal using tput
alias curl='curl -s'                                                               # Silent curl
alias diff="diff -y --suppress-common-lines"                                       # Side-by-side diff without common lines
alias mkdir='mkdir -pv'                                                            # Make directories and parents
alias mv='mv -iv'                                                                  # Interactive move with verbose
# File manager aliases based on OS
alias week='date +%V'                                                              # Display current week number

#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# Operating System ls
#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
if [[ $IS_DEBIAN == true ]]; then
    # Linux/Debian ls configuration using dircolors
    if command -v dircolors >/dev/null 2>&1; then
        test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
        export LS_COLORS
    fi
    # Linux/Debian ls aliases
    alias l="ls -1F --color=auto"                                                      # List files with indicators
    alias la='ls -1AF --color=auto'                                                    # List all files with indicators
    alias ll='ls -FlAhp --color=auto'                                                  # Detailed list view
    alias ls="command ls --color=auto"                                                 # Enable colored ls
    alias lsa="command ls -a --color=auto"                                             # List all with colors
    alias lsd="ls -lF --color=auto | grep --color=never '^d'"                          # List directories only
fi
alias less='less -FSRXc'                                                           # Enhanced less
alias lr='ls -R | grep ":$" | sed -e '\''s/:$//'\'' -e '\''s/[^-][^\/]*\//--/g'\'' -e '\''s/^/   /'\'' -e '\''s/-/|/'\'''  # Recursive ls with formatting

#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# Docker
#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
alias drm='docker rm $(docker ps -a -q)'                                           # Remove all Docker containers
alias dstop='docker stop $(docker ps -a -q)'                                       # Stop all Docker containers
dclean() { echo "Stopping all Docker containers..."; docker stop $(docker ps -a -q); echo "Removing all Docker containers..."; docker rm $(docker ps -a -q) } # Clean up Docker containers
drun() { echo "Running Docker container: $@"; docker run -d --name "$@"; }         # Run a Docker container in detached mode with a specified name
dsh() { echo "Accessing shell in Docker container: $@"; docker exec -it "$@" /bin/bash; } # Access a shell inside a Docker container

#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# YAML and JSON Manipulation Functions Using yq
#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
yvalid() { yq eval '.' "$1" > /dev/null }                                                                          # Validate YAML syntax
y2j()    { yq eval '.' "$1" -o=json }                                                                              # Convert YAML to JSON
jvalid() { yq eval '.' "$1" -o=json > /dev/null }                                                                  # Validate JSON syntax
j2y()    { cat "$1" | yq eval '.' -o=yaml }                                                                        # Convert JSON to YAML
jfmt()   { cat "$1" | jq . }                                                                                       # Format JSON

#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# Git Primary Functions
#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
s() { echo "git status --short"; git status --short; }                                                             # Show short status
ga() { echo "git add ."; git add .; }                                                                              # Add all changes
gc() { echo "git add -A && git commit -am $@"; git add -A && git commit -am "$@"; }                                # Add all changes and commit with a message
gpr() { echo "git pull --rebase --prune"; git pull --rebase --prune; }                                             # Pull with rebase and prune
grc() { echo "git add . && git rebase --continue"; git add . && git rebase --continue; }                           # Continue rebase after adding changes
gp() { echo "git push origin $(git rev-parse --abbrev-ref HEAD)"; git push origin "$(git rev-parse --abbrev-ref HEAD)"; } # Push to the current branch
gco() { echo "git checkout -b $1 2>/dev/null || git checkout $1"; git checkout -b "$1" 2>/dev/null || git checkout "$1"; } # Checkout or create a feature branch
gcom() { echo "git checkout main"; git checkout main; }                                                            # Checkout master branch
gm() { echo "git pull --rebase --prune && git merge --squash --ff-only $1"; git pull --rebase --prune && git merge --squash --ff-only "$1"; } # Pull and merge a feature branch with squash
gl() { echo "git log --pretty=format:'%Cblue%h %ad %Cgreen%cn %Creset%s %Cred%d' --decorate --date=short -n 20"; git log --pretty=format:'%Cblue%h %ad %Cgreen%cn %Creset%s %Cred%d' --decorate --date=short -n 20; } # Display formatted git log
gwa() {                                                                                                        # Create git worktree as peer directory
    if [[ -z "$1" ]]; then
        echo "Usage: gwa <branch-name>"
        echo "Example: gwa 45-sdd"
        return 1
    fi

    local branch_name="$1"

    # Find git root
    local git_root
    git_root=$(git rev-parse --show-toplevel 2>/dev/null)

    if [[ -z "$git_root" ]]; then
        echo "Error: Not in a git repository"
        return 1
    fi

    # Get repo name and parent directory
    local repo_name=$(basename "$git_root")
    local parent_dir=$(dirname "$git_root")
    local worktree_path="${parent_dir}/${repo_name}-${branch_name}"

    # Check if worktree already exists at this path
    if git worktree list | grep -q "^${worktree_path} "; then
        local existing_branch=$(git worktree list | grep "^${worktree_path} " | awk '{print $3}' | sed 's/\[//' | sed 's/\]//')
        if [[ "$existing_branch" == "$branch_name" ]]; then
            echo "Branch exists: $branch_name"
            echo "Worktree exists: $worktree_path"
            return 0
        else
            echo "Error: Worktree exists at $worktree_path with different branch: $existing_branch"
            return 1
        fi
    fi

    # Check if branch exists
    local branch_exists=false
    if git rev-parse --verify "$branch_name" >/dev/null 2>&1; then
        branch_exists=true
        echo "Branch exists: $branch_name"
    else
        echo "Created branch: $branch_name"
    fi

    # Create worktree
    git worktree add "$worktree_path" "$branch_name" >/dev/null 2>&1
    if [[ $? -eq 0 ]]; then
        echo "Created worktree: $worktree_path"
    else
        echo "Error: Failed to create worktree"
        return 1
    fi
}

wt() {                                                                                                            # List worktree names for current repo
    # Find repo root by walking up looking for .git directory (no git commands)
    local dir="$PWD"
    while [[ "$dir" != "/" ]]; do
        if [[ -d "$dir/.git" ]]; then
            break
        fi
        dir="${dir:h}"
    done

    if [[ "$dir" == "/" ]]; then
        echo "Error: Not in a git repository"
        return 1
    fi

    local repo_name="${dir:t}"    # basename via zsh expansion
    local parent_dir="${dir:h}"   # dirname via zsh expansion

    # List sibling directories matching <repo-name>-* and extract suffix
    setopt local_options null_glob
    for path in "${parent_dir}/${repo_name}-"*(/N); do
        local name="${path:t}"          # basename via zsh expansion
        echo "${name#${repo_name}-}"    # strip prefix
    done
}

#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# Git Pull All Repos
#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
gpa() {                                                                                                            # Git pull all repos in ~/src on main with clean working tree
    local src_dir="$HOME/src"
    [[ ! -d "$src_dir" ]] && echo "Directory not found: $src_dir" && return 1
    local repo branch before after count
    for dir in "$src_dir"/*/; do
        [[ ! -d "$dir/.git" ]] && continue
        repo="${dir:t:r}"
        branch=$(git -C "$dir" symbolic-ref --quiet --short HEAD 2>/dev/null)
        if [[ "$branch" != "main" && "$branch" != "master" ]]; then
            echo "$repo: on $branch"
            continue
        fi
        if ! git -C "$dir" diff-index --quiet HEAD -- 2>/dev/null; then
            echo "$repo: uncommitted changes"
            continue
        fi
        before=$(git -C "$dir" rev-parse HEAD 2>/dev/null)
        git -C "$dir" pull --rebase --prune >/dev/null 2>&1
        after=$(git -C "$dir" rev-parse HEAD 2>/dev/null)
        if [[ "$before" == "$after" ]]; then
            echo "$repo: up to date"
        else
            count=$(git -C "$dir" rev-list --count "$before".."$after" 2>/dev/null)
            echo "$repo: pulled $count commits"
        fi
    done
}

#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# Git Extraneous Functions
#-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
gcommits() { echo "git shortlog --summary --numbered"; git shortlog --summary --numbered; }                        # Show commit summaries
gd() { echo "git diff $@"; git diff "$@"; }                                                                        # Show git diff
gls() { echo "git log --pretty=format:'%Cblue%ad %Cgreen%cn %Creset%s' --decorate -n 20 --stat --date=short"; git log --pretty=format:'%Cblue%ad %Cgreen%cn %Creset%s %Cred%d' --decorate --date=short -n 20 --stat; } # Display detailed git log with stats
gpf() { echo "git push -f origin $(git rev-parse --abbrev-ref HEAD)"; git push -f origin "$(git rev-parse --abbrev-ref HEAD)"; } # Force push current branch
gprb() { echo "git fetch && git rebase origin/master"; git fetch && git rebase origin/master; }                    # Fetch and rebase from master
grh() { echo "git reset HEAD^"; git reset HEAD^; }                                                                 # Reset to previous commit
gs() { echo "git log -1 --pretty=format:'%Cblue%ad %Cgreen%cn %Creset%s' --decorate --date=short $1"; git log -1 --pretty=format:'%Cblue%ad %Cgreen%cn %Creset%s' --decorate --date=short "$1"; } # Show last commit with specific format
gsb() { echo "git show-branch -a"; git show-branch -a; }                                                           # Show all branches
gsb2() { echo "git show-branch $(git symbolic-ref --short HEAD) master"; git show-branch "$(git symbolic-ref --short HEAD)" master; } # Show current and master branch
gt() { echo "git tag -l"; git tag -l; }                                                                            # List all tags
gb() { echo "git branch -avv"; git branch -avv; }                                                                  # List all branches with details
gbd() { echo "git branch -D $@"; git branch -D "$@"; }                                                             # Delete a feature branch
gbehind() { echo "git log --pretty=format:'%Cblue%ad %Creset%s%Cgreen [%cn] %Cred%d' --decorate --date=short -n 25 ^$(git rev-parse --abbrev-ref HEAD) master"; git log --pretty=format:"%Cblue%ad %Creset%s%Cgreen [%cn] %Cred%d" --decorate --date=short -n 25 "^$(git rev-parse --abbrev-ref HEAD)" master; } # Show commits behind master
gca() { echo "git commit --amend"; git commit --amend; }                                                           # Amend the last commit
gchanges() { echo "git log $(git merge-base HEAD master)..$(git symbolic-ref --short HEAD)"; git log "$(git merge-base HEAD master)".."$(git symbolic-ref --short HEAD)"; } # Show changes between current branch and master

#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# Python Virtual Environment Support
#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# Function to find the nearest .venv directory
find_virtualenv() {
    local dir="$PWD"
    while [[ "$dir" != "/" ]]; do
        if [[ -d "$dir/.venv" ]]; then
            echo "$dir/.venv"
            return
        fi
        dir="${dir:h}"    # dirname via zsh expansion
    done
    return 1
}

# Function to load the virtual environment
# Make sure find_virtualenv is defined above load_virtualenv
load_virtualenv() {
    green='%F{119}'
    reset='%f'

    local venv_path
    venv_path=$(find_virtualenv)

    if [[ -n "$venv_path" ]]; then
        # If a virtualenv is found and it's different from the current one
        if [[ "$VIRTUAL_ENV" != "$venv_path" ]]; then
            # Deactivate the current virtualenv if one is active
            if [[ -n "$VIRTUAL_ENV" ]]; then
                deactivate
            fi
            # Activate the new virtualenv
            source "$venv_path/bin/activate"
            print -P "\n${green}Activated Python Virtual Environment:\n$venv_path${reset}"
        fi
    else
        # If no virtualenv is found and one is active, deactivate it
        if [[ -n "$VIRTUAL_ENV" ]]; then
            deactivate
            print -P "\n${green}Deactivated Python Virtual Environment${reset}"
        fi
    fi
}

#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# Prompt Theme (dark/light background support)
#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# State file: ~/.theme (contains "dark" or "light")
# Toggle: t [dark|light]  — no arg toggles, see theme() in zshrc
# On startup: reads ~/.theme, falls back to macOS appearance, defaults to dark
if [[ -z "$ZSH_THEME_BG" ]]; then
    if [[ -f ~/.theme ]]; then
        export ZSH_THEME_BG=$(cat ~/.theme)
    elif [[ $IS_MACOS == true ]]; then
        local _auto=$(defaults read -g AppleInterfaceStyleSwitchesAutomatically 2>/dev/null)
        local _mode=$(defaults read -g AppleInterfaceStyle 2>/dev/null)
        if { [[ "$_auto" == "1" && -z "$_mode" ]] || [[ "$_mode" == "Dark" ]]; }; then
            export ZSH_THEME_BG=dark
        else
            export ZSH_THEME_BG=light
        fi
    else
        export ZSH_THEME_BG=dark
    fi
fi

_apply_ls_colors() {
    if [[ $IS_MACOS == true ]]; then
        if [[ "$ZSH_THEME_BG" == "light" ]]; then
            export LSCOLORS="ExFxBxDxCxegedabagacad"
        else
            export LSCOLORS="GxBxxxxxCxxxxxxxxxGxGx"
        fi
    fi
}

# Apply ls colors on shell startup
_apply_ls_colors

#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# Prompt and CD tweaks
#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
precmd() {
    # Sync theme from ~/.theme state file (for cross-pane updates)
    if [[ -f ~/.theme ]]; then
        local _ft=$(cat ~/.theme)
        if [[ "$_ft" != "$ZSH_THEME_BG" ]]; then
            export ZSH_THEME_BG="$_ft"
            _apply_ls_colors
            # Update iTerm2 profile for this pane if on macOS
            [[ $IS_MACOS == true ]] && printf '\e]1337;SetProfile=%s\a' "$([[ "$_ft" == dark ]] && echo Dark || echo Light)"
        fi
    fi

    # Get current user (use zsh variable instead of id command)
    local current_user="${USER:-${USERNAME:-unknown}}"

    # Color palettes for dark and light backgrounds
    local branch_color username_color dir_color
    local reset='%f'
    if [[ "$ZSH_THEME_BG" == "light" ]]; then
        branch_color='%F{22}'       # Dark green for branch
        username_color='%F{24}'     # Dark teal for username
        dir_color='%F{130}'         # Dark orange/brown for directory path
    else
        branch_color='%F{10}'       # Bright green for branch (matches \033[92m)
        username_color='%F{14}'     # Bright cyan for username
        dir_color='%F{220}'         # Gold for directory path (matches \033[38;2;255;215;0m)
    fi

    # Git branch information
    local git_info=""
    local branch_name

    # Check if we're in a git repository and can access it
    if git rev-parse --git-dir >/dev/null 2>&1; then
        branch_name=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null)

        if [[ -n "$branch_name" ]]; then
            # Check if there are uncommitted changes
            if ! git diff-index --quiet HEAD -- 2>/dev/null; then
                git_info="${branch_color}[${branch_name}*]${reset} "
            else
                git_info="${branch_color}[${branch_name}]${reset} "
            fi
        fi
    fi

    # Custom path display - show ~/ when in home, ~/path otherwise
    local display_path
    if [[ "$PWD" == "$HOME" ]]; then
        display_path="~/"
    else
        display_path="%~"
    fi

    PROMPT="${git_info}${username_color}${current_user}${reset} ${dir_color}${display_path} \$${reset} "
}

# This is a ZSHRC hook that runs after the directory is changed
function chpwd() {
    # By default list files when we change directories (OS-specific)
    # Use full path to avoid PATH issues in hook context
    if [[ $IS_MACOS == true ]]; then
        /bin/ls -1FG
    else
        /usr/bin/ls -1F --color=auto 2>/dev/null || /bin/ls -1F --color=auto
    fi

    # Run the virtualenv load/unload logic:
    load_virtualenv
}
